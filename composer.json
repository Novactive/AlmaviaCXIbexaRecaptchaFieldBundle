{
  "name": "almaviacx/ibexarecaptchafieldbundle",
  "license": "MIT",
  "type": "ibexa-bundle",
  "description": "Bundle providing reCAPTCHA field for the IBEXA Form Builder",
  "homepage": "https://github.com/Novactive/AlmaviaCXIbexaRecaptchaFieldBundle",
  "keywords": [
    "ibexa",
    "bundle"
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://updates.ibexa.co"
    }
  ],
  "autoload": {
    "psr-4": {
      "Novactive\\Bundle\\IbexaRecaptchaFieldBundle\\": "src/bundle",
      "Novactive\\Bundle\\IbexaRecaptchaField\\": "src/lib"
    }
  },
  "require": {
    "php": ">=8.2",
    "ibexa/experience": "^5.0",
    "ibexa/form-builder": "^5.0",
    "excelwebzone/recaptcha-bundle": "^1.5",
    "symfony/http-kernel": "^7.3",
    "symfony/config": "^7.3",
    "symfony/dependency-injection": "^7.3",
    "symfony/yaml": "^7.3",
    "symfony/form": "^7.3",
    "symfony/options-resolver": "^7.3"
  },
  "extra": {
    "thanks": {
      "name": "adamwojs/ezplatform-form-builder-recaptcha-field",
      "url": "https://github.com/adamwojs/ezplatform-form-builder-recaptcha-field"
    }
  }
}
